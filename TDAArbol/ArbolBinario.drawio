        <mxCell id="2-XUT0oZ3bGEiFmJ63H--51" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;span style=&quot;font-size: 14px;&quot;&gt;R I D = Pre Orden. Apenas toco el nodo, lo proceso.&amp;nbsp;&lt;/span&gt;&lt;div&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;I R D = In Orden. Proceso el nodo la segunda vez que lo toco.&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;I D R = Pos Orden. Proceso el nodo la ultima vez que lo toco.&lt;/span&gt;&lt;/div&gt;" vertex="1">
