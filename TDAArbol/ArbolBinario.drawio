        <mxCell id="2-XUT0oZ3bGEiFmJ63H--45" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Las veces que voy a tocar un nodo son N + 1. Siendo N la cantidad maxima de hijos que puede tener.&lt;div&gt;En este caso, toco a los nodos 3 veces.&lt;/div&gt;" vertex="1">
